{
  "name": "wave-os-portal",
  "displayName": "Wave OS Portal",
  "publisher": "xbuildy",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wave-os.openDesktop",
        "title": "Open Wave OS",
        "category": "Wave OS"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wave-os",
          "title": "Wave OS",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "wave-os": [
        {
          "type": "webview",
          "id": "wave-os.portal",
          "name": "Portal"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --external:vscode",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --external:vscode --watch"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.17.0",
    "typescript": "^4.9.0"
  }
}